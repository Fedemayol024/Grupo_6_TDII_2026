/**
 * @brief Definición de estados para la MEF principal de la secuencia.
 */
typedef enum {
	ESTADO_ENCENDIDO = 0,
	ESTADO_APAGADO
} secuenciaState_t;

/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */

#define LED_DELAY_MS 200  /**< Tiempo de transición para el parpadeo de los LEDs. */

/* USER CODE END PD */

