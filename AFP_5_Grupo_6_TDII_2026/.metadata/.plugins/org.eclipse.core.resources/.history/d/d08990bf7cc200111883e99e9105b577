/**
 * @brief Arreglo de descriptores de LEDs utilizando nuestro driver API_led.
 * @details Desacopla completamente el hardware mediante la estructura led_t.
 */
static led_t leds_array[] = {
		{LD1_GPIO_Port, LD1_Pin, LED_LOGIC_ACTIVE_HIGH},
		{LD2_GPIO_Port, LD2_Pin, LED_LOGIC_ACTIVE_HIGH},
		{LD3_GPIO_Port, LD3_Pin, LED_LOGIC_ACTIVE_HIGH}
};

static const uint8_t cant_leds = sizeof(leds_array) / sizeof(leds_array[0]);

/* Instancia del botón de usuario utilizando API_debounce */
static button_t user_button;

/* Instancia del retardo no bloqueante utilizando API_delay */
static delay_t led_timer;

/* Variables de control de la secuencia */
static int indice = 0;
static secuenciaState_t estado_secuencia = ESTADO_ENCENDIDO;
static int8_t sentido = 1;  // Dirección del recorrido de los LEDs (1 o -1)

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
