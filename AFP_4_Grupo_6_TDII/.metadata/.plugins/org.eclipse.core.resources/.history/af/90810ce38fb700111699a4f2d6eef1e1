// Vector de LEDs usando los nombres reales de main.h
led_t vector_leds[3] = {LD1_Pin, LD2_Pin, LD3_Pin};

// Variables para el antirebote y lectura del botón
buttonStatus_t estadoBotonAnterior = 0;
uint8_t secuencia_actual = 0;
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MPU Configuration--------------------------------------------------------*/
  MPU_Config();

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART3_UART_Init();
  /* USER CODE BEGIN 2 */
  // Declaramos los cronómetros (delays no bloqueantes)
  delay_t delay_seq1, delay_seq2, delay_seq3_L1, delay_seq3_L2, delay_seq3_L3, delay_seq4;

  delayInit(&delay_seq1, 150);
  delayInit(&delay_seq2, 300);
  delayInit(&delay_seq3_L1, 100);
  delayInit(&delay_seq3_L2, 300);
  delayInit(&delay_seq3_L3, 600);
  delayInit(&delay_seq4, 150);

  uint8_t indice_led = 0; // Para recorrer el vector en la Secuencia 1
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
    {
      // Leemos el pulsador
      buttonStatus_t estadoBotonActual = ReadButton_GPIO();

      if (estadoBotonActual && !estadoBotonAnterior) {
          secuencia_actual++;
          if (secuencia_actual > 3) {
              secuencia_actual = 0;
          }

          WriteLedOff_GPIO(LD1_Pin);
          WriteLedOff_GPIO(LD2_Pin);
          WriteLedOff_GPIO(LD3_Pin);
      }
      estadoBotonAnterior = estadoBotonActual;


      // --- MÁQUINA DE ESTADOS ---
      switch (secuencia_actual) {

          case 0: // SECUENCIA 1
              if (delayRead(&delay_seq1)) {
                  WriteLedOff_GPIO(vector_leds[indice_led]);

                  indice_led++;
                  if (indice_led > 2) indice_led = 0;

                  WriteLedOn_GPIO(vector_leds[indice_led]);
              }
              break;

          case 1: // SECUENCIA 2
              if (delayRead(&delay_seq2)) {
                  ToggleLed_GPIO(LD1_Pin);
                  ToggleLed_GPIO(LD2_Pin);
                  ToggleLed_GPIO(LD3_Pin);
              }
              break;

          case 2: // SECUENCIA 3
              if (delayRead(&delay_seq3_L1)) ToggleLed_GPIO(LD1_Pin);
              if (delayRead(&delay_seq3_L2)) ToggleLed_GPIO(LD2_Pin);
              if (delayRead(&delay_seq3_L3)) ToggleLed_GPIO(LD3_Pin);
              break;

          case 3: // SECUENCIA 4
              if (delayRead(&delay_seq4)) {
                  ToggleLed_GPIO(LD1_Pin);
                  ToggleLed_GPIO(LD3_Pin);

                  if (HAL_GPIO_ReadPin(GPIOB, LD1_Pin) == GPIO_PIN_SET) {
                      WriteLedOff_GPIO(LD2_Pin);
                  } else {
                      WriteLedOn_GPIO(LD2_Pin);
                  }
              }
              break;
      }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

